{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "norms-mcp-preview",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "containers": [{
    "class_name": "NormsResolverContainer",
    "image": "../../norms-document-pipeline/Dockerfile",
    "max_instances": 2,
    "instance_type": "basic"
  }],
  "durable_objects": {"bindings": [{"name": "NORMS_RESOLVER", "class_name": "NormsResolverContainer"}]},
  "migrations": [{"tag": "resolver-container-v1", "new_sqlite_classes": ["NormsResolverContainer"]}],
  "vars": {"ENVIRONMENT": "preview"},
  "observability": {"enabled": true, "head_sampling_rate": 0.01}
}
