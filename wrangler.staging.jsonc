{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "norms-mcp-staging",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "containers": [{
    "name": "norms-resolver",
    "class_name": "NormsResolverContainer",
    "image": "registry.cloudflare.com/db9156a9c16c01ee4341b429b2dd448d/norms-resolver:0.5.3",
    "max_instances": 1,
    "instance_type": "basic"
  }],
  "durable_objects": {
    "bindings": [
      {"name": "NORMS_RESOLVER", "class_name": "NormsResolverContainer"},
      {"name": "PDF_UPLOAD_COORDINATOR", "class_name": "PdfUploadDurableObject"}
    ]
  },
  "migrations": [{
    "tag": "staging-v1",
    "new_sqlite_classes": ["NormsResolverContainer", "PdfUploadDurableObject"]
  }],
  "r2_buckets": [{
    "binding": "PDF_UPLOADS",
    "bucket_name": "norms-pdf-uploads"
  }],
  "vars": {
    "ENVIRONMENT": "staging",
    "MCP_REQUEST_TIMEOUT_MS": "60000"
  },
  "observability": {"enabled": true, "head_sampling_rate": 0.01}
}
